<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Lets the app ask the system installer to run, for its own updates.

        It grants nothing by itself: the user turns it on for this app in a system settings page,
        and every install still goes through Android's own confirmation screen. Android 8 replaced
        the old device-wide "unknown sources" switch with this per-app one precisely so a sideloaded
        app cannot open the door for anything else. There is no silent install here and there cannot
        be — that needs INSTALL_PACKAGES, which is granted to system apps only.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Wi-Fi drops broadcast packets while the radio dozes unless something holds a multicast lock,
        and the doodle rooms find each other by broadcast. Without this the app talks and hears
        nobody, which is indistinguishable from nobody being there.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Volume sliders. System brightness uses WRITE_SETTINGS, which is a special permission
         granted from a system page rather than a normal runtime prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Screen mirror. The overlay permission is what lets the picture stay on the second panel while
         another app is in the foreground; without it the mirror would die the moment you left. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        All files access, for the FTP server.

        This is what makes the server behave like the 3DS's ftpd — connect and the device is there —
        rather than showing a handful of media folders. It is granted by the user in a system
        settings screen, not by a prompt, and it is the reason this app is a sideloaded APK: Google
        Play restricts this permission to file managers and backup tools. Distributing from GitHub,
        as this project already does, that restriction does not apply.

        Nothing else in the app uses it, and with the FTP server switched off nothing reads it.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DualScreen">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            resizeableActivity is required for the activity to be allowed onto a secondary display.
            The configChanges list keeps the WebView alive across rotation and display moves rather
            than reloading the page every time.
        -->
        <activity
            android:name=".ScreenActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.DualScreen.Fullscreen" />
        <activity
            android:name=".ProfilesActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ProfileEditActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DiscoverActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity
            android:name=".MacroBuilderActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".MacroEditActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LayoutEditorActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity
            android:name=".GameCodesActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <!--
            Hands a downloaded APK to the system installer, and nothing else to anybody.

            Not exported, so no other app can ask it for anything: the installer receives a
            content:// URI with a one-shot read grant attached to the intent, which is how a file in
            this app's private cache becomes readable to the installer for exactly as long as it
            takes to read. See res/xml/update_paths.xml for the single folder it can reach.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>


        <activity
            android:name=".WidgetsActivity"
            android:exported="false"
            android:resizeableActivity="true" />



        <activity
            android:name=".NotesActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".NoteEditorActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ScribbleActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ControlsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".AppearanceActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <!-- Exported so the system's input-method settings page can open it as this keyboard's own
             settings screen; it is also reachable from the tool grid. -->
        <activity
            android:name=".KeyboardActivity"
            android:exported="true"
            android:resizeableActivity="true" />

        <activity
            android:name=".MirrorActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".FtpActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".StreamActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ThemesActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <!--
            The FTP console window. Launched by the setup screen when the server starts, and left on
            the back stack behind it so Back returns to the settings rather than out of the app.
        -->
        <activity
            android:name=".FtpConsoleActivity"
            android:exported="false"
            android:label="@string/ftp_console"
            android:resizeableActivity="true" />

        <service
            android:name=".MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".MacrosActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <service
            android:name=".MacroOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="An always-on overlay of user-placed shortcut buttons, which must survive leaving the app to be of any use." />
        </service>

        <service
            android:name=".FtpService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="An FTP server for transferring files to and from the handheld over the local network, which must keep running while the user works on the PC at the other end." />
        </service>

        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/keyboard_title"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>
