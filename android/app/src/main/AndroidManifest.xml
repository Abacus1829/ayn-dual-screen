<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Volume sliders. System brightness uses WRITE_SETTINGS, which is a special permission
         granted from a system page rather than a normal runtime prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Screen mirror. The overlay permission is what lets the picture stay on the second panel while
         another app is in the foreground; without it the mirror would die the moment you left. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DualScreen">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            resizeableActivity is required for the activity to be allowed onto a secondary display.
            The configChanges list keeps the WebView alive across rotation and display moves rather
            than reloading the page every time.
        -->
        <activity
            android:name=".ScreenActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.DualScreen.Fullscreen" />
        <activity
            android:name=".NotesActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ControlsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".AppearanceActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <!-- Exported so the system's input-method settings page can open it as this keyboard's own
             settings screen; it is also reachable from the tool grid. -->
        <activity
            android:name=".KeyboardActivity"
            android:exported="true"
            android:resizeableActivity="true" />

        <activity
            android:name=".MirrorActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <service
            android:name=".MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".MacrosActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <service
            android:name=".MacroOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="An always-on overlay of user-placed shortcut buttons, which must survive leaving the app to be of any use." />
        </service>

        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/keyboard_title"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>
