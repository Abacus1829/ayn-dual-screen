<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DualScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorAccent">@color/accent</item>

        <!--
            One transition for the whole app.

            Screens used to arrive with whatever the platform default was, which differs by Android
            version and by manufacturer skin — so the app moved differently on the handheld than it
            did on the emulator, and differently again on somebody else's device. Setting it here
            makes every screen enter and leave the same way, and makes it one line to change.
        -->
        <item name="android:windowAnimationStyle">@style/Animation.DualScreen</item>

        <!-- Dialogs follow the app rather than the platform. Both attributes are set because
             AppCompat reads its own and the framework reads the other. -->
        <item name="alertDialogTheme">@style/Theme.DualScreen.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.DualScreen.Dialog</item>
    </style>

    <!--
        Dialogs, which were the last stock-Android surface in the app: a light rounded rectangle
        arriving in the middle of a dark accented interface. Wide on purpose — a confirmation on a
        handheld is read at arm's length and the default is narrow enough to wrap every sentence.
    -->
    <style name="Theme.DualScreen.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowMinWidthMajor">70%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <!--
        The second-screen session, which is the one place the shared transition is wrong.

        A window opening on the *other panel* is not arriving from anywhere the user is looking, so
        sliding it up reads as a glitch on a display they are not currently touching — and worse, the
        animation plays on the panel the game is on if the session is opening over it. It appears and
        disappears instead. A companion screen showing up beside a game should be as undramatic as a
        second monitor waking.
    -->
    <style name="Theme.DualScreen.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@style/Animation.DualScreen.None</item>
    </style>

    <style name="Animation.DualScreen.None" parent="@android:style/Animation" />

    <!--
        A short fade with a small lift. Deliberately restrained and deliberately quick: 160ms is
        about the shortest a movement can be and still read as a movement, and this plays every time
        anybody opens anything. An animation you notice on the tenth use is too long.
    -->
    <style name="Animation.DualScreen" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_exit</item>
    </style>

    <!-- A section heading inside a card. -->
    <style name="Label" parent="">
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Explanatory line under a heading. -->
    <style name="Caption" parent="">
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:layout_marginTop">@dimen/space_tight</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Action" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">@dimen/button_padding</item>
        <item name="android:paddingBottom">@dimen/button_padding</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Field" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:padding">13dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:fontFamily">monospace</item>
    </style>

</resources>
