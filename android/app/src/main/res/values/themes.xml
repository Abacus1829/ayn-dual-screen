<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DualScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.DualScreen.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- A section heading inside a card. -->
    <style name="Label" parent="">
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Explanatory line under a heading. -->
    <style name="Caption" parent="">
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Action" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Field" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:padding">13dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

</resources>
