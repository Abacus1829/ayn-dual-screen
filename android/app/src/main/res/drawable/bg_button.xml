<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="@color/edge" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/edge_hi" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_hi" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="@color/edge_hi" />
        </shape>
    </item>
</selector>
