<?xml version="1.0" encoding="utf-8"?>
<!--
    Mirror: one screen duplicated onto another.

    A drawn icon rather than a font character. ⧉, ▥, ◨ and ◎ were each tried as glyphs and each
    rendered as tofu on the test device — the stock font simply does not carry those blocks, and
    which ones it does carry is not something to discover one build at a time. A vector always
    draws.

    tint is set in code so it can follow the skin's glyph colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- The far screen: outline only, sitting behind and up-left. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:pathData="M3.8,3.8 L14.2,3.8 A1.4,1.4 0 0 1 15.6,5.2 L15.6,12.4 A1.4,1.4 0 0 1 14.2,13.8 L3.8,13.8 A1.4,1.4 0 0 1 2.4,12.4 L2.4,5.2 A1.4,1.4 0 0 1 3.8,3.8 Z" />

    <!-- The near screen: filled, overlapping down-right. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9.8,10.2 L20.2,10.2 A1.4,1.4 0 0 1 21.6,11.6 L21.6,18.8 A1.4,1.4 0 0 1 20.2,20.2 L9.8,20.2 A1.4,1.4 0 0 1 8.4,18.8 L8.4,11.6 A1.4,1.4 0 0 1 9.8,10.2 Z" />
</vector>
