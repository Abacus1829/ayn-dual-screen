<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_screen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="accent"
                    android:text="@string/stream_title"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/backButton"
                    style="@style/Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_done" />
            </LinearLayout>

            <!--
                Said plainly and first. Pairing genuinely works; video genuinely does not exist.
                Somebody who pairs successfully and then finds no way to start a game should have
                been told before they began, not after.
            -->
            <TextView
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/stream_blurb"
                android:textSize="@dimen/text_caption" />

            <!-- The PC's address. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stream_host" />

                <EditText
                    android:id="@+id/hostField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints="off"
                    android:hint="@string/stream_host_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingTop="@dimen/space"
                    android:paddingBottom="@dimen/space"
                    android:tag="accentFill"
                    android:text="@string/stream_connect"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- What answered, once something has. -->
            <LinearLayout
                android:id="@+id/hostCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="accentEdge"
                android:visibility="gone">

                <TextView
                    android:id="@+id/hostName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="accent"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hostDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/text_detail" />

                <Button
                    android:id="@+id/pairButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space"
                    android:paddingTop="@dimen/space"
                    android:paddingBottom="@dimen/space"
                    android:tag="accentFill"
                    android:text="@string/stream_pair"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/unpairButton"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:text="@string/stream_unpair"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
                The PIN, which is the whole interaction: this number has to be big enough to read
                off a handheld while typing it on a PC across the room.
            -->
            <LinearLayout
                android:id="@+id/pinCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_section"
                android:tag="accentEdge"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stream_pin_label" />

                <TextView
                    android:id="@+id/pinText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.3"
                    android:tag="accent"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pinHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/stream_pin_hint"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/text_detail" />
            </LinearLayout>

            <!-- The handshake, step by step, because five steps can fail in five ways. -->
            <LinearLayout
                android:id="@+id/logCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stream_log" />

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_dim"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
