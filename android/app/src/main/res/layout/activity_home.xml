<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Deliberately has no id. An inner view called "root" makes view binding generate a field that
         shadows getRoot(), so binding.root would hand setContentView a view that already has a parent. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_screen">

            <!-- ===== header ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/accentBar"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/space"
                    android:background="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_tagline"
                        android:textColor="@color/text_faint"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/modeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!--
                ===== the dashboard =====

                What this screen used to open with was a form: pick a game, type an address, press
                connect. That is the right set of controls and the wrong first thing to say, because
                nine launches in ten the answer is already known and the question is just "is it
                there?".

                So state comes first and controls come second. The headline is whatever is actually
                running, the line under it is where and what, and the primary action is inside the
                same card as the thing it acts on rather than four cards further down.
            -->
           <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="accentEdge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:tag="accent"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_tight"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/status_idle"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/text_detail" />

                <!--
                    What is running on the device right now, as one-tap chips. Built in code and
                    absent entirely when there is nothing to say — a row of empty state is worse
                    than no row.
                -->
                <LinearLayout
                    android:id="@+id/chipRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/openButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space"
                    android:paddingTop="@dimen/button_padding_primary"
                    android:paddingBottom="@dimen/button_padding_primary"
                    android:tag="accentFill"
                    android:text="@string/action_open"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===== connect to ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_connect_to" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/gameSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_small"
                        android:layout_weight="1"
                        android:minHeight="46dp" />

                    <Button
                        android:id="@+id/detectButton"
                        style="@style/Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_detect" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gameHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/text_caption" />

                <!--
                    The way into saved connections, on the card people already look at to connect.
                    Hidden when nothing has been saved, so a first run is not offering an empty list.
                -->
                <Button
                    android:id="@+id/profilesButton"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/home_saved_connections"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== address (advanced) ===== -->
            <LinearLayout
                android:id="@+id/addressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_address" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/hostField"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_small"
                        android:layout_weight="3"
                        android:autofillHints="none"
                        android:hint="@string/hint_host"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/portField"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autofillHints="none"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/findButton"
                        style="@style/Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_small"
                        android:layout_weight="1"
                        android:text="@string/action_find" />

                    <Button
                        android:id="@+id/testButton"
                        style="@style/Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_test" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== display (advanced, >1 display only) ===== -->
            <LinearLayout
                android:id="@+id/displayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_display" />

                <RadioGroup
                    android:id="@+id/displayGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_tight" />
            </LinearLayout>

            <!-- ===== behaviour (advanced) ===== -->
            <LinearLayout
                android:id="@+id/behaviourCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_behaviour" />

                <LinearLayout
                    android:id="@+id/toggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ===== scan results ===== -->
            <LinearLayout
                android:id="@+id/foundCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_found" />

                <LinearLayout
                    android:id="@+id/foundGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!--
                The status line and the primary button used to live here, four cards below the top
                of the screen. Both moved into the dashboard card at the top: a status you have to
                scroll to is not a status, and a primary action separated from the state it acts on
                is a button you have to think about.
            -->

            <!-- ===== tools ===== -->
            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:text="@string/label_tools" />

            <GridLayout
                android:id="@+id/toolGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:columnCount="4" />

            <TextView
                android:id="@+id/modeBlurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:layout_marginBottom="@dimen/space_tight"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_faint"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>
    </ScrollView>

    <!--
        The boot animation, over everything and clickable so a tap skips it.

        Last child, so it covers the home screen while that screen builds itself underneath — which
        is the point: nothing waits for the animation, and the animation waits for nothing.
    -->
    <com.abacus.dualscreen.boot.AbacusBootView
        android:id="@+id/bootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:contentDescription="@string/boot_wordmark"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
