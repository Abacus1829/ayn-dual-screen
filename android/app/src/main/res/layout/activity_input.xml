<?xml version="1.0" encoding="utf-8"?>
<!--
    Input diagnostics. Deliberately plain: it exists to be read and pasted into a bug report, not
    to look like the rest of the app.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_screen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="accent"
                    android:text="@string/input_title"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/input_blurb"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <Button
                android:id="@+id/backButton"
                style="@style/Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_done" />
        </LinearLayout>

        <!-- The sequence, run by the same watcher the home screen uses. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space"
            android:orientation="vertical"
            android:padding="@dimen/space"
            android:tag="accentEdge">

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/input_sequence" />

            <TextView
                android:id="@+id/sequenceState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_tight"
                android:tag="accent"
                android:text="@string/input_seq_progress"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <TextView
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_sequence_detail" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/summaryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/copyButton"
                style="@style/Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_small"
                android:text="@string/input_copy" />

            <Button
                android:id="@+id/clearButton"
                style="@style/Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/input_clear" />
        </LinearLayout>

        <!-- The events themselves. Monospace, because these are lined-up fields to be compared. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:padding="@dimen/space"
            android:tag="card">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_label" />
        </ScrollView>

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space"
            android:text="@string/input_devices" />

        <TextView
            android:id="@+id/devicesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_tight"
            android:layout_marginBottom="@dimen/space_tight"
            android:fontFamily="monospace"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_label" />
    </LinearLayout>
</FrameLayout>
