<?xml version="1.0" encoding="utf-8"?>
<!--
    ftpd, as it looks on a Switch: blue status strip, a Menu row, the log filling the screen with
    colour-coded tags, and the current session boxed at the bottom.

    Reading down —
      • status strip: name and version, the address it is serving on, the clock, storage and battery
      • menu row
      • the log: [COMMAND] in green, [RESPONSE] in cyan, everything else plain
      • the session box: what the connected client is looking at right now

    Single screen on purpose. The Thor's second panel is one display, and nothing here assumes
    another one exists.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:orientation="vertical">

    <!-- Status strip. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2F6FB5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_small"
        android:paddingTop="@dimen/space_tight"
        android:paddingEnd="@dimen/space_small"
        android:paddingBottom="@dimen/space_tight">

        <TextView
            android:id="@+id/consoleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/consoleClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/consoleStorage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- Menu row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141414"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_small"
        android:paddingEnd="@dimen/space_tight">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="@string/ftp_menu"
            android:textColor="#D0D0D0"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/smallerButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/console_smaller"
            android:textColor="#D0D0D0"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/biggerButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/console_bigger"
            android:textColor="#D0D0D0"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/clearButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/ftp_clear"
            android:textColor="#D0D0D0"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/stopButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/ftp_stop_short"
            android:textColor="#E58A8A"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/backButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/nav_back"
            android:textColor="#9FB4D8"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- The log. -->
    <ScrollView
        android:id="@+id/consoleScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="6dp"
        android:paddingTop="@dimen/space_tight"
        android:paddingEnd="6dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/consoleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="1dp"
            android:textColor="#E6E6E6"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_caption" />
    </ScrollView>

    <!-- The session box: where the connected client is, framed the way ftpd frames it. -->
    <TextView
        android:id="@+id/sessionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/console_box"
        android:fontFamily="monospace"
        android:minHeight="52dp"
        android:padding="@dimen/space_small"
        android:textColor="#D0D0D0"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
