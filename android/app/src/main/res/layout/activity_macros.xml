<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_screen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="accent"
                    android:text="@string/macros_title"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/backButton"
                    style="@style/Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_done" />
            </LinearLayout>

            <TextView
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/macros_blurb"
                android:textSize="@dimen/text_caption" />

            <!-- ===== profile ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macros_profile" />

                <Spinner
                    android:id="@+id/profileSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="46dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/newProfile"
                        style="@style/Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/macros_new_profile" />

                    <Button
                        android:id="@+id/deleteProfile"
                        style="@style/Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/macros_delete_profile" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== buttons ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="card">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macros_buttons" />

                <LinearLayout
                    android:id="@+id/macroList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/addMacro"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:text="@string/macros_add" />

                <!--
                    The way into the two optional screens. Here rather than on the home grid, which
                    already has ten tiles: somebody looking for macros or layouts is looking at this
                    screen, and somebody who never uses either never sees them.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/builderButton"
                        style="@style/Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/macros_open_builder" />

                    <Button
                        android:id="@+id/layoutsButton"
                        style="@style/Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_small"
                        android:layout_weight="1"
                        android:text="@string/macros_open_layouts" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== the pad ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space"
                android:layout_marginBottom="@dimen/space_tight"
                android:orientation="vertical"
                android:padding="@dimen/space"
                android:tag="accentEdge">

                <TextView
                    android:id="@+id/padStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/text_detail" />

                <Button
                    android:id="@+id/overlayButton"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mirror_grant"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/padButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingTop="@dimen/space_screen"
                    android:paddingBottom="@dimen/space_screen"
                    android:tag="accentFill"
                    android:text="@string/macros_show"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/moveButton"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:text="@string/macros_move" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
