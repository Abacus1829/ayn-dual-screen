<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Top-LEFT deliberately: the mod's own page puts its settings cog top-right, so this sits opposite
        rather than on top of it. Low opacity so it doesn't compete with the game UI underneath.
    -->
    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:alpha="0.45"
        android:background="@drawable/bg_round"
        android:contentDescription="@string/screen_menu_title"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu_dots" />

    <!--
        The connection state, opposite the menu button.

        Small, dim and self-hiding: it exists for the moment the session drops, and a permanent badge
        over somebody's inventory would be worse than no badge at all. Shown while anything other
        than a healthy connection is going on, then faded out.
    -->
    <TextView
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:alpha="0"
        android:background="@drawable/bg_round"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/text"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6070810"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/screen_menu_title"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!--
            The page controls. Inside the menu rather than on the screen, because the second display
            is the whole product and a permanent toolbar across it would be taking space from the
            thing somebody bought a handheld with two screens to look at.
        -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/backToScreenButton"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minWidth="240dp"
            android:text="@string/action_back_to_screen"
            android:visibility="gone" />

        <!--
            Whether this window takes the controller. Off by default, so the game keeps it; on for
            the rare page with a text field in it, which cannot be typed into otherwise.
        -->
        <Button
            android:id="@+id/focusButton"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minWidth="240dp"
            android:text="@string/focus_take_input" />

        <Button
            android:id="@+id/quitButton"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="240dp"
            android:text="@string/action_quit_to_menu" />

        <Button
            android:id="@+id/reloadButton"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="240dp"
            android:text="@string/action_reload" />

        <Button
            android:id="@+id/cancelButton"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="240dp"
            android:text="@string/action_cancel" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retryButton"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:text="@string/action_retry" />

        <Button
            android:id="@+id/backButton"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="200dp"
            android:text="@string/action_back" />

        <!--
            An unambiguous way out while it is retrying. "Change address" also returns to the menu, but
            it reads as a detour rather than an exit, so someone sitting through a retry that is never
            going to succeed has nothing that plainly says stop.
        -->
        <Button
            android:id="@+id/errorQuitButton"
            style="@style/Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="200dp"
            android:text="@string/action_quit_to_menu" />

    </LinearLayout>

</FrameLayout>
